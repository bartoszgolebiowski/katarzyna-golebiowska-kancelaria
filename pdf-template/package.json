{
  "name": "kancelaria-pdf-template",
  "version": "1.0.0",
  "private": true,
  "description": "Branded HTML template and PDF generator for Kancelaria Notarialna Katarzyna Golebiowska.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "kancelaria-pdf": "bin/generate-pdf.js"
  },
  "scripts": {
    "build": "node bin/build-site.js",
    "build:pdf": "node bin/build-site.js --pdf",
    "clean": "node bin/clean.js",
    "pdf": "node bin/generate-pdf.js",
    "pdf:html": "node bin/render-html.js"
  },
  "keywords": [
    "pdf",
    "html-template",
    "puppeteer"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "puppeteer": "^24.10.2"
  }
}
